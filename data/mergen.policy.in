<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  MERGEN — a minimal PDF viewer.
  Copyright (C) 2026 MEGAS.
  SPDX-License-Identifier: GPL-3.0-only
-->
<policyconfig>

  <vendor>MEGAS</vendor>
  <vendor_url>https://github.com/sudo-megas/MERGEN</vendor_url>

  <action id="io.github.sudomegas.mergen.read-document">
    <description>Open a PDF owned by another user</description>
    <message>Authentication is required to open a PDF you do not have permission to read</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@MERGEN_HELPER_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
