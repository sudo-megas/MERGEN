# CMake writes into build/, but build/docs/ and build/icons/ are tracked source.
/build/*
!/build/docs/
!/build/icons/

# Package artefacts from makepkg run in-tree.
/pkg/
/src-pkg/
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Package artefacts from scripts/build-deb.sh. debhelper reads debian/ from the
# root of the tree it builds, so the script copies packaging/debian up to /debian
# for the duration; it builds in obj-<triplet>/, dpkg writes beside the tree, and
# the script collects the result into dist/. None of it is source.
/debian/
/dist/
/obj-*/
*.deb
*.ddeb
*.buildinfo
*.changes

# Editor and tooling scratch.
*.swp
*~
.cache/
compile_commands.json


# Fixtures for the acceptance suites. Written by
# build/docs/tests/make-fixtures.py rather than tracked — they are derived, and
# large.pdf alone is 300 KB.
/test.pdf
/outline.pdf
/outline-v2.pdf
/annot.pdf
/colour.pdf
/evil.pdf
/huge.pdf
/large.pdf
/locked.pdf
/out.pdf
/renamed.pdf
/redacted.pdf
/src.pdf

# Compiled acceptance suites, and the directory z9 makes for its portal test.
/build/docs/tests/z*check
!/build/docs/tests/z*check.cpp
!/build/docs/tests/z*check.sh
# Compiler output kept beside each suite by run-all.sh, for when one fails.
/build/docs/tests/*.log
/z11/
