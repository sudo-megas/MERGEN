# CMake writes into build/, but build/docs/ and build/icons/ are tracked source.
/build/*
!/build/docs/
!/build/icons/

# Package artefacts from makepkg run in-tree.
/pkg/
/src-pkg/
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Editor and tooling scratch.
*.swp
*~
.cache/
compile_commands.json

# Working notes from the v2.0 research pass. MZ.md is the source of truth;
# these are scratch, not project documentation.
/docs/
