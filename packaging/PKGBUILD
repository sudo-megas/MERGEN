# Maintainer: MEGAS <halil@namli.xyz>

pkgname=mergen
pkgver=2.0.1
pkgrel=1
pkgdesc='A minimal PDF viewer'
arch=('x86_64')
url='https://github.com/sudo-megas/MERGEN'
license=('GPL-3.0-only')
depends=('qt6-base' 'poppler-qt6' 'polkit' 'ttf-cascadia-code-nerd' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'gcc' 'git' 'qpdf')
# qpdf builds this package but does not run it, which is why it moved to
# makedepends at 2.0.1.
#
# It is there for content-level redaction and nothing else — MZ.md §3. Redaction
# was withdrawn at Z11 and its code, though still compiled, is called from
# nowhere. makepkg builds with LTO on (OPTIONS=lto), so the optimiser drops
# those functions as unreachable, the references to libqpdf go with them, and
# -Wl,--as-needed then leaves no NEEDED entry at all. Verified against the
# published 2.0.0 binary: no libqpdf in readelf -d, no qpdf symbols, no qpdf
# strings. Installing it was making every reader carry a library their copy
# never loads.
#
# It stays in makedepends because the source still has to compile and link
# against it before LTO removes it. If redaction is ever reachable again, this
# moves back to depends — that is the check to make, not a version to trust.
#
# The licence stays GPL-3.0-only, which is what every source file in the tree
# declares. It differs from TRITIUM's -or-later on purpose: a licence is not
# something to widen for the sake of matching a sibling.
#
# SKIP is correct for a VCS source, but it is worth being exact about what that
# does and does not buy: integrity here rests on the transport and on the
# repository, not on a signature. The tag this builds from is lightweight, so
# nothing is verified cryptographically. Signing it (git tag -s) and adding
# validpgpkeys would change that; until then the comment should not claim it.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -Wno-dev
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
